<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/cardColor_Green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="18dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iconProfileCard"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_profile"
                android:layout_margin="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <EditText
                android:id="@+id/edt_name_profile"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/closeProfile"
                android:layout_margin="15dp"
                android:textSize="25sp"
                android:hint="Raul Rodrigues"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/edt_name"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/edt_name_profile"
                app:layout_constraintStart_toEndOf="@id/iconProfileCard"
                android:hint="rodrigues"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="10dp"
                />
            <EditText
                android:id="@+id/edt_password"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/edt_name"
                android:hint="Confirme sua senha"
                android:layout_margin="10dp"
                android:focusable="false"
                app:passwordToggleEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageButton
                android:id="@+id/closeProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_close"
                android:layout_margin="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageButton
                android:id="@+id/editProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="15dp"
                android:background="@drawable/edit_icon"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>