<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/cd_agenda"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:cardBackgroundColor="@color/Weak_green"
        android:layout_margin="10dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/nameProductCd"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/tv_cornes"
                android:hint="Produto"
                android:textAlignment="center"
                android:textSize="20sp"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="MissingConstraints" />

            <EditText
                android:id="@+id/cnpjCdAgenda"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:textAlignment="center"
                android:hint="Cnpj"
                android:textSize="20sp"
                android:background="@drawable/tv_cornes"
                app:layout_constraintTop_toBottomOf="@+id/nameProductCd"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/amountCdAgenda"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:textSize="20sp"
                android:hint="Quantidade"
                android:gravity="center"
                android:background="@drawable/tv_cornes"
                app:layout_constraintTop_toBottomOf="@id/cnpjCdAgenda"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/dateCd"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="15dp"
                android:hint="Data"
                android:textAlignment="center"
                android:background="@drawable/tv_cornes"
                app:layout_constraintTop_toBottomOf="@+id/amountCdAgenda"
                app:layout_constraintStart_toEndOf="@+id/switchStatus"/>


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchStatus"
                android:layout_width="80dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@id/amountCdAgenda"
                android:visibility="visible"
                android:checked="false"
                android:textOff="Recebido"
                android:textOn="Nao_Recebido"
                android:textColor="@color/white"
                android:thumb="@drawable/thumb_selector"
                android:track="@drawable/track_selector"
                android:gravity="center" />
            <ImageButton
                android:id="@+id/editButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_margin="10dp"
                android:background="@drawable/edit_icon"
                android:visibility="visible"/>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_margin="10dp"
                android:text="Salvar"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_margin="10dp"
                android:text="Cancelar"
                android:textStyle="italic"
                android:visibility="gone"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>